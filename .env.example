# Supabase (shared with BBD Launcher / ASC Pricing / QSB)
NEXT_PUBLIC_SUPABASE_URL=https://xockuiyvxijuzlwlsfbu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth v5
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (optional in dev; required in prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Break-glass admin password login. Disabled unless BOTH are set. It only
# authenticates: the email must be an active launcher admin profile AND have
# PSB access in the launcher (launcher_can_open_app = true).
# Leave empty in production unless you need it; unset to revoke live sessions.
BOOTSTRAP_ADMIN_EMAIL=
# min 8 chars
ADMIN_PASSWORD=

# BBD Launcher base URL (links to launcher user management + "View as" exit).
# Defaults to https://bbd-launcher.vercel.app
NEXT_PUBLIC_LAUNCHER_URL=
